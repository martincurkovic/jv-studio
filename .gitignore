# Roland's manual stays out of the repo (it is their copyright); the table generated from it is committed
/manual

# Python / uv / pytest
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# editors and the OS
.DS_Store
.idea/
.vscode/
.ruff_cache/
.mypy_cache/

# logs a run might drop next to the code (the app's own logs live in ~/.jv-studio)
*.log

# SysEx captured from a unit or saved while testing is the owner's own data: keep it out unless it is a deliberate test fixture
*.syx
!tests/fixtures/**/*.syx

# half-written backups (the app writes name.syx.part, then renames it)
*.part

# standalone app builds (pyside6-deploy / Nuitka), written by scripts/build_*: the version from the git tag, the generated deploy spec, and the outputs
src/jv_studio/_build_version.py
*.spec
*.build/
*.dist/
*.onefile-build/
nuitka-crash-report.xml
*.app/
deployment/
*.dmg
*.AppImage
*.exe
/dmg-staging
/AppDir
/appimagetool-*
/JV-Studio-Setup.exe

# the System 6 theme's font: downloaded by tools/fetch_system6_font.py, not committed until its licence is confirmed
src/jv_studio/ui/fonts/
